      "label": {
        "en": "Real-time refresh (s)",
        "fr": "Rafraîchissement temps réel (s)",
        "de": "Echtzeit-Aktualisierung (s)",
        "es": "Actualización en tiempo real (s)"
      },
      "description": {
        "en": "With an API key only; without one, every 20 minutes.",
        "fr": "Avec une clé d'API uniquement ; sans clé, toutes les 20 minutes.",
        "de": "Nur mit API-Schlüssel; ohne alle 20 Minuten.",
        "es": "Solo con clave de API; sin ella, cada 20 minutos."
      },
      "required": false,
      "default": 60,
      "min": 30,
      "max": 3600
    },
    {
      "key": "horizon_minutes",
      "type": "number",
      "label": {
        "en": "Departures shown (minutes ahead)",
        "fr": "Départs affichés (minutes à venir)",
        "de": "Angezeigte Abfahrten (Minuten voraus)",
        "es": "Salidas mostradas (minutos)"
      },
      "required": false,
      "default": 90,
      "min": 15,
      "max": 240
    },
    {
      "key": "delay_threshold",
      "type": "number",
      "label": {
        "en": "Delay alert from (minutes)",
        "fr": "Alerte de retard à partir de (minutes)",
        "de": "Verspätungsalarm ab (Minuten)",
        "es": "Aviso de retraso desde (minutos)"
      },
      "description": {
        "en": "Delay that fires the \"Departure delayed\" scene trigger.",
        "fr": "Retard qui déclenche le déclencheur de scène « Départ en retard ».",
        "de": "Verspätung, die den Szenenauslöser „Abfahrt verspätet\" auslöst.",
        "es": "Retraso que activa el disparador de escena «Salida retrasada»."
      },
      "required": false,
      "default": 5,
      "min": 1,
      "max": 60
    }
